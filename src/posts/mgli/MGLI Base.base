views:
  - type: table
    name: View
    filters:
      and:
        - file.folder.startsWith("mgli/lektionen/")
        - "!Woche.isEmpty()"
    order:
      - file.name
      - Woche
      - title
      - schriftliche_notizen
      - übungs_serie
    sort:
      - property: Woche
        direction: ASC
    columnSize:
      file.name: 180
      note.schriftliche_notizen: 253
